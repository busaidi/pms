upstream pms_gunicorn {
    server unix:/run/pms/gunicorn.sock;
}

server {
    listen 80;
    listen [::]:80;
    server_name omanskylight.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://omanskylight.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name omanskylight.com;

    ssl_certificate /etc/letsencrypt/live/omanskylight.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/omanskylight.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PmsSSL:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    client_max_body_size 20m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    access_log /var/log/nginx/pms-access.log;
    error_log /var/log/nginx/pms-error.log;

    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;

    location /static/ {
        alias /home/hamed/pms/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location = /admin/login/ {
        limit_req zone=pms_login burst=5 nodelay;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://pms_gunicorn;
    }

    location = /login/ {
        limit_req zone=pms_login burst=5 nodelay;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://pms_gunicorn;
    }

    location / {
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://pms_gunicorn;
    }
}
